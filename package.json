{
  "name": "buddy",
  "version": "1.1.0",
  "private": true,
  "description": "Claude Code buddy plugin: an ASCII companion above your prompt that remembers your rules and flags Claude's shortcuts",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run --dir tests && claude plugin test plugins/buddy",
    "test:unit": "vitest run --dir tests",
    "test:hooks": "claude plugin test plugins/buddy",
    "types": "claude -p \"/plugin-types $PWD/types\" < /dev/null > /dev/null",
    "typecheck": "npm run types && tsc --noEmit && tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate --strict . && claude plugin validate --strict plugins/buddy",
    "release:check": "scripts/release-check.sh",
    "live": "scripts/live-proof.sh",
    "live:configs": "scripts/live-configs.sh",
    "live:drawer": "scripts/live-drawer.sh",
    "audit": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "claude-code-buddy",
    "buddy",
    "companion",
    "coding-companion",
    "ascii-art",
    "terminal-pet",
    "virtual-pet",
    "duck",
    "prompt-suggestions",
    "function-hooks",
    "claude-code-hooks",
    "claude-mods",
    "professor"
  ]
}
